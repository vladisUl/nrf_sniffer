     - 'e:/ncs_workspaces/project/new/802154_sniffer/sysbuild.conf'
  sysbuild: 'true'
version: '0.1.0'
west:
  command: 'E:\ncs_toolchains\toolchains\dcbdc366a1\opt\bin\Scripts\west build --build-dir e:/ncs_workspaces/project/new/802154_sniffer/build e:/ncs_workspaces/project/new/802154_sniffer --pristine --board promicro_nrf52840_my/nrf52840 -- -DCONFIG_DEBUG_THREAD_INFO=y -DBOARD_ROOT=e:/ncs_workspaces/project/new/802154_sniffer'
