cmake:
  application:
    source-dir: 'E:/ncs_workspaces/zigbee-r23-340/zephyr/share/sysbuild'
  board:
    name: 'promicro_nrf52840_my'
    path:
     - 'E:/ncs_workspaces/project/new/802154_sniffer/boards/others/promicro_nrf52840_my'
    qualifiers: 'nrf52840'
    revision: ''
  images:
   - name: '802154_sniffer'
     source-dir: 'E:/ncs_workspaces/project/new/802154_sniffer'
     type: 'MAIN'
  kconfig:
    files:
     - 'E:/ncs_workspaces/project/new/802154_sniffer/build/_sysbuild/empty.conf'
     - 'e:/ncs_workspaces/project/new/802154_sniffer/sysbuild.conf'
